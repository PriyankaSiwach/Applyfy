# Copy this file to `.env.local` in the project root, then fill in real values.
# Next.js loads `.env.local` automatically (do not commit `.env.local`).

# Required for AI features (analyze, cover letter, interview, etc.)
# Replace with your real key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
# Do not commit a real key. Do not use OPENAI_API_KEY= with nothing after = in .env.local
# (empty value overrides `.env` and breaks AI routes).
# Optional alias (same secret; use one or the other)
# OPENAI_KEY=

# Stripe (Checkout + Customer Portal + webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Must be Price IDs (price_...), not Product IDs (prod_...)
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (auth + publicMetadata.subscriptionTier)
# Production URL in Clerk Dashboard must be https://applyfy.net
# IMPORTANT: Publishable keys embed your Clerk Frontend API host. If you migrated off
# AWS Amplify, regenerate API keys in Clerk Dashboard → API Keys and replace both keys below.
# Old keys decode to clerk.*.amplifyapp.com and will break auth + Stripe checkout.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/
# Do NOT set NEXT_PUBLIC_CLERK_PROXY_URL or NEXT_PUBLIC_CLERK_JS_URL to an Amplify URL.
# Optional: mirror server-side session limits in Clerk Dashboard → Sessions:
# set "Maximum lifetime" and "Inactivity timeout" both to 2 hours so API
# tokens align with the app’s 2h client guard (see SessionTimeoutGuard.tsx).

# Contact form (/contact) — same Resend setup as results email
# RESEND_API_KEY=
# RESULTS_FROM_EMAIL=Applyfy <onboarding@yourdomain.com>
# Optional inbox (defaults to applyfy0@gmail.com)
# CONTACT_TO_EMAIL=
